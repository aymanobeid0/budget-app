# Supabase Environment Configuration for Dokploy / VPS

############
# Secrets (Generate secure random values for production)
############
# Password for PostgreSQL database
POSTGRES_PASSWORD=your_secure_postgres_password_here_32_chars

# Secret for signing JWT tokens (min 32 characters)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# Public Anonymous API Key (used by Flutter App)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_jwt_token_payload_here

# Service Role Secret Key (admin only)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_jwt_token_payload_here

############
# Network / Domain Routing (Dokploy Traefik)
############
# The public domain pointing to your Kong gateway (Port 8000)
# e.g. https://supabase.yourdomain.com OR http://YOUR_VPS_IP:8000
API_EXTERNAL_URL=https://supabase.yourdomain.com

# Studio / Dashboard URL
SITE_URL=https://studio.yourdomain.com

############
# Exposed Ports
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3000
POSTGRES_PORT=5432
